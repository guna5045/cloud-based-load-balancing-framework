{
  "name": "servers",
  "version": "1.0.0",
  "private": true,
  "description": "Independent server instances for Cloud-Based Load Balancing Framework",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:s1": "tsx watch src/server.ts S1 3001",
    "dev:s2": "tsx watch src/server.ts S2 3002",
    "dev:s3": "tsx watch src/server.ts S3 3003",
    "start:s1": "tsx src/server.ts S1 3001",
    "start:s2": "tsx src/server.ts S2 3002",
    "start:s3": "tsx src/server.ts S3 3003",
