# ==============================================================================
# Frontend Environment Configuration Template
# Cloud-Based Load Balancing Framework
# ==============================================================================
# For local development: copy to .env (defaults to http://localhost:5000)
# For Render deployment: configure in Render Static Site Environment Variables
# ==============================================================================

# Backend API Base URL (Render Web Service URL in production)
VITE_API_URL=https://your-backend-app.onrender.com

# WebSocket / Socket.IO Server URL (Defaults to VITE_API_URL if omitted)
VITE_WS_URL=https://your-backend-app.onrender.com

# Application Title
VITE_APP_TITLE="Cloud-Based Load Balancing Framework"
