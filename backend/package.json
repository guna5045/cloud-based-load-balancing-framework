{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend service for Cloud-Based Load Balancing Framework",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm install --include=dev && npm install --prefix ../servers --include=dev",
    "build": "tsc && npm run build --prefix ../servers",
    "test": "tsx tests/roundRobin.test.ts",
    "test:phase5": "tsx tests/phase5.test.ts",
    "test:phase6": "tsx tests/phase6.test.ts",
    "test:phase7": "tsx tests/phase7.test.ts",
    "test:phase8": "tsx tests/phase8.test.ts",
    "test:phase9": "tsx tests/phase9.test.ts",
    "test:serverManagement": "tsx tests/serverManagement.test.ts",
    "test:all": "tsx tests/roundRobin.test.ts && tsx tests/phase5.test.ts && tsx tests/phase6.test.ts && tsx tests/phase7.test.ts && tsx tests/phase8.test.ts && tsx tests/phase9.test.ts && tsx tests/serverManagement.test.ts",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3"
  }
}
