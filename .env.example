# ==============================================================================
# Cloud-Based Load Balancing Framework - Environment Configuration Template
# ==============================================================================
# For local development: copy to .env or backend/.env
# For Render deployment: configure in Render Dashboard under Environment Variables
# ==============================================================================

# --- Gateway & Load Balancer ---
# Port provided automatically by Render in production via process.env.PORT
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Production Frontend URL (Render static site or custom domain)
# Multiple origins can be comma-separated. Localhost is permitted automatically.
FRONTEND_URL=https://your-frontend-app.onrender.com

# --- Root Server Cluster Configuration (Internal Process Network) ---
INITIAL_SERVERS=S1,S2,S3
SERVER_HOST=localhost
SERVER_S1_PORT=3001
SERVER_S2_PORT=3002
SERVER_S3_PORT=3003

# --- Request Routing & Forwarding Timeouts ---
REQUEST_TIMEOUT_MS=3000

# --- Telemetry & Health Monitoring ---
MONITOR_INTERVAL_MS=5000
HEALTH_CHECK_INTERVAL_MS=5000

# --- State Machine & Overload Detection Thresholds ---
WARNING_THRESHOLD=60
OVERLOAD_THRESHOLD=80
RECOVERY_THRESHOLD=70
OVERLOAD_CONFIRMATION_SAMPLES=2
RECOVERY_CONFIRMATION_SAMPLES=2

# --- Hierarchical 3-Child Auto-Scaling Configuration ---
EXPANSION_FACTOR=3
CHILD_SERVER_PORT_START=3100
CHILD_SERVER_PORT_END=3999
CHILD_STARTUP_TIMEOUT_MS=5000

# --- Scalability Safety Limits ---
MAX_SCALING_DEPTH=10
MAX_SERVER_PROCESSES=50
